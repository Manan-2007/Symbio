# SYMBIO environment variables. Copy to .env.local (git-ignored) and fill in.
# Without any of these the app still runs on local demo data with honest fallbacks.
# Never commit real values. Anything prefixed NEXT_PUBLIC_ is visible in browser code.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Geoapify maps, geocoding and routing. Server-only: the app proxies it through /api/geo/*.
GEOAPIFY_API_KEY=

# Azure OpenAI for the assistant and the vision classifier. Server-only (/api/ai/*).
# AZURE_OPENAI_ENDPOINT may be the full chat-completions URL from the Azure portal,
# or the resource URL (deployment + API version are then appended).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
