# Symbio environment variables. None are required for the browser-local prototype.
# Copy to .env.local for later integrations. Never commit real values.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (deferred). NEXT_PUBLIC_* values are bundled into browser code and are public.
# The publishable key is only safe behind correct Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_ or import into client code.
SUPABASE_SECRET_KEY=

# Google Maps (deferred). Keep browser and server keys separate and restricted.
NEXT_PUBLIC_ENABLE_MAPS=false
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server-only.
GOOGLE_MAPS_SERVER_KEY=
