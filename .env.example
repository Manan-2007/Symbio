# SYMBIO environment variables. None are required: the app runs fully on local demo data.
# Copy to .env.local for later integrations. Never commit real values.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (deferred). NEXT_PUBLIC_* values are bundled into browser code and are public.
# The publishable key is only safe behind correct Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_ or import into client code.
SUPABASE_SECRET_KEY=

# Google Maps (optional). Set ENABLE_MAPS=true plus a referrer-restricted browser key to replace the
# schematic map with Google Maps. Keep browser and server keys separate.
NEXT_PUBLIC_ENABLE_MAPS=false
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server-only.
GOOGLE_MAPS_SERVER_KEY=

# AI features (optional). The browser calls these URLs directly, so point them at your own server
# endpoints that hold any model API keys. Never put an AI provider key in a NEXT_PUBLIC_ variable.
# Classifier: POST { image: dataURL } -> { materialId, confidence, notes[] }
NEXT_PUBLIC_AI_CLASSIFIER_ENDPOINT=
# Assistant: POST { question } -> { answer }
NEXT_PUBLIC_AI_ASSISTANT_ENDPOINT=
